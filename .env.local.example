# Local dev environment overrides. Copy to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# Google reCAPTCHA v2 — get from https://www.google.com/recaptcha/admin
# Site key is public (shipped in the browser bundle).
VITE_RECAPTCHA_SITE_KEY=

# Secret key is server-only — used by /api/create-booking.js to verify tokens.
RECAPTCHA_API_KEY=
